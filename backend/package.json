{
  "name": "@servicecare/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/local.ts",
    "build": "npm run build:lambda && npm run build:analytics && npm run build:ticket-events",
    "build:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs",
    "build:analytics": "esbuild src/analytics/stream.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/analytics/index.cjs",
    "build:ticket-events": "esbuild src/events/stream.ts src/notifications/worker.ts --bundle --platform=node --target=node22 --format=cjs --entry-names=[name] --out-extension:.js=.cjs --outdir=dist/ticket-events",
    "build:visual": "esbuild src/visual/lambda.ts src/visual/worker.ts --bundle --platform=node --target=node22 --format=cjs --external:sharp --outdir=dist/visual",
    "build:ticket-tools": "esbuild src/agent-tools/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/ticket-tools/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.900.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1161.0",
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1165.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-eventbridge": "^3.900.0",
    "@aws-sdk/client-firehose": "^3.1161.0",
    "@aws-sdk/client-quicksight": "^3.1161.0",
    "@aws-sdk/client-rekognition": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-sesv2": "^3.1165.0",
    "@aws-sdk/client-sfn": "^3.1161.0",
    "@aws-sdk/client-sns": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@aws-sdk/s3-presigned-post": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@hono/node-server": "^2.1.3",
    "@servicecare/contracts": "*",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.10.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.4",
    "@img/sharp-linux-x64": "0.35.5"
  }
}
