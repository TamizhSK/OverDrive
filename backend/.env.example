PORT=3001
WEB_ORIGIN=http://localhost:5173
# Local mode uses in-memory storage and clearly labelled demonstration FAQs.
# Optional: answer chat questions through an AgentCore harness (works in local mode; needs AWS credentials and `eu.` model access).
# The harness or the console's harness-endpoint ARN is accepted. KNOWLEDGE_BASE_ID supplies the approved passages the harness must cite.
# AGENTCORE_HARNESS_ARN=arn:aws:bedrock-agentcore:eu-north-1:123456789012:harness/ExampleHarness-AbCdEfGhIj
# AGENTCORE_MODEL_ID=eu.amazon.nova-pro-v1:0
# KNOWLEDGE_BASE_ID=ABCDE12345
# AWS configuration is injected into the Lambda (Terraform) or the ECS task definition (CloudFormation), never into the browser.